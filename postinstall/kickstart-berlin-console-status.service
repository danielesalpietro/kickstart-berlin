[Unit]
Description=kickstart-berlin - schermata informativa su tty1 (issue #27)
Documentation=https://github.com/danielesalpietro/kickstart-berlin/issues/27
Conflicts=getty@tty1.service
After=getty@tty1.service network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
# Interprete esplicito invece di affidarsi a shebang+bit eseguibile sul
# file: console-status.py non è più coperto dal chmod +x automatico di
# *.sh nelle late-commands di iso/user-data (era .sh, ora .py) - questo
# evita del tutto il problema invece di allargare quel glob.
ExecStart=/usr/bin/python3 /opt/kickstart-berlin/console-status.py
StandardInput=null
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=always
RestartSec=2
UtmpIdentifier=tty1
UtmpMode=user

[Install]
WantedBy=multi-user.target
