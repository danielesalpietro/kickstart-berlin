#cloud-config
# autoinstall (Subiquity) per le Fasi 1-3 — vedi README, issue #1, #2, #3.
#
# Questo file è un template: i placeholder __SSH_AUTHORIZED_KEY__ e
# __STORAGE_CONFIG__ vengono sostituiti da scripts/build-iso.sh coi
# valori passati/derivati a build-time (chiave SSH, topologia disco,
# default in config/autoinstall-defaults.json). Nessuna chiave è
# hardcoded qui.
autoinstall:
  version: 1

  locale: en_US.UTF-8
  keyboard:
    layout: us

  identity:
    hostname: kickstart-berlin
    username: admin
    # Hash placeholder (password casuale, mai usata) con prefisso "!":
    # convenzione standard di /etc/shadow per un account gia' bloccato
    # (e' esattamente cio' che fa "usermod -L" sotto il cofano). Bloccato
    # fin dalla creazione dell'account, nessuna finestra temporale in cui
    # l'hash sia valido. L'unico metodo di accesso previsto e' la chiave
    # SSH iniettata a build-time (vedi ssh.allow-pw sotto).
    #
    # In precedenza il blocco avveniva via late-commands ("usermod -L
    # admin"), ma si e' rivelato inaffidabile: in due run reali indipendenti
    # (CI GitHub Actions e boot test Hyper-V locale, entrambi con rete
    # diretta) il comando falliva con exit 6 ("utente non trovato") a quel
    # punto dell'installazione, nonostante la documentazione Subiquity
    # affermi che l'account identity venga creato durante l'installazione
    # e non al primo boot. Vedi logbook-fase1.md per i dettagli.
    password: "!$6$Z1HJIr/8n/LtcnpB$YRIOAp8vqPGrNSTHHwiyaDbx1rjs9JHuCWoZeXxV45c5H9SgJiCdWn92s2Ltt/69pliWRPxHsCg6RFSMpC1va."

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "__SSH_AUTHORIZED_KEY__"

  # Partizionamento a azioni esplicite (Fase 2, issue #2): sistema (EFI +
  # root, size configurabile) + partizione dati XFS per il Datastore
  # Grastorp. Il frammento esatto (topologia a 1 o 2 dischi fisici) viene
  # scelto e iniettato da scripts/build-iso.sh — vedi
  # iso/storage-single-disk.yaml e iso/storage-dual-disk.yaml.
  storage: __STORAGE_CONFIG__

  # "updates: security" e' la chiave nativa Subiquity per gli update di
  # sicurezza (equivalente autoinstall dei moduli cloud-init generici
  # "package_update"/"package_upgrade", rimossi: non sono chiavi
  # riconosciute a livello autoinstall - Subiquity emette un warning
  # "Unrecognized top-level key" e segnala che diventera' un errore
  # nelle versioni future).
  updates: security
  packages:
    - openssh-server
    # NOTA: "hyperv-daemons" (comodita' di solo testing, per vedere IP/
    # hostname da Get-VMNetworkAdapter) e' stato provato e RIMOSSO: in un
    # boot test QEMU/WSL ha fatto fallire l'intera installazione (curtin
    # "system-install --download-only hyperv-daemons" con exit 100, causa
    # non investigata oltre — vedi logbook-fase1.md). Non e' un requisito
    # della Fase 1 (il nodo target e' bare-metal, non Hyper-V): per capire
    # l'IP di una VM di test Hyper-V si puo' usare l'ARP dell'host per il
    # MAC address della VM (funziona senza toccare l'autoinstall).

  late-commands:
    # L'account admin ha la password bloccata (vedi identity.password
    # sopra) e l'unico accesso e' via chiave SSH: richiedere ANCHE una
    # password per sudo lo renderebbe di fatto inutilizzabile (nessuna
    # password valida esiste). L'accesso e' gia' garantito dalla chiave
    # SSH, quindi NOPASSWD qui non abbassa la sicurezza reale.
    #
    # A differenza di "usermod -L admin" (rimosso, vedi sopra e
    # logbook-fase1.md), scrivere un file statico in /etc/sudoers.d non
    # dipende dall'esistenza dell'utente nel database NSS del target in
    # quel momento dell'installazione: e' una semplice scrittura di file.
    - >-
      curtin in-target --target=/target -- sh -c
      'echo "admin ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-admin-nopasswd
      && chmod 0440 /etc/sudoers.d/90-admin-nopasswd'

    # Monta il Datastore Grastorp (partizione __DATASTORE_FILESYSTEM__,
    # formattata nello storage.config con label __DATASTORE_LABEL__).
    # Path finale a convenzione ESXi-style: __DATASTORE_MOUNT_ROOT__/<UUID
    # reale generata da mkfs>, con symlink leggibile fisso
    # __DATASTORE_MOUNT_ROOT__/__DATASTORE_SYMLINK_NAME__ -> quella UUID.
    # La UUID non è prevedibile a design-time (mkfs la genera in fase di
    # storage.config), quindi il mount va fatto qui via fstab invece che
    # con una azione "mount" statica — stesso procedimento manuale
    # documentato da Vast.ai per /var/lib/docker (mkfs -> blkid -> fstab),
    # solo automatizzato.
    - >-
      curtin in-target --target=/target -- sh -c
      'set -e;
      DEV=$(blkid -L "__DATASTORE_LABEL__");
      DS_UUID=$(blkid -s UUID -o value "$DEV");
      mkdir -p "__DATASTORE_MOUNT_ROOT__/$DS_UUID";
      echo "UUID=$DS_UUID __DATASTORE_MOUNT_ROOT__/$DS_UUID __DATASTORE_FILESYSTEM__ defaults 0 2" >> /etc/fstab;
      ln -s "$DS_UUID" "__DATASTORE_MOUNT_ROOT__/__DATASTORE_SYMLINK_NAME__"'

    # Installa lo script post-install (postinstall/setup.sh, Fase 3+,
    # issue #3 e successive) come systemd unit oneshot al primo boot —
    # architettura descritta in README ("Script post-install... eseguito
    # al primo boot via systemd unit oneshot"). Copia diretta (non via
    # "curtin in-target": /cdrom, dove risiede l'ISO con /postinstall/,
    # non è garantito accessibile dentro quel chroot) — "systemctl enable
    # --root=" abilita l'unit sul target offline senza bisogno di chroot.
    - >-
      sh -c
      'set -e;
      mkdir -p /target/opt/kickstart-berlin;
      cp -r /cdrom/postinstall/. /target/opt/kickstart-berlin/;
      chmod +x /target/opt/kickstart-berlin/setup.sh;
      mkdir -p /target/etc/systemd/system;
      cp /target/opt/kickstart-berlin/kickstart-berlin-postinstall.service /target/etc/systemd/system/kickstart-berlin-postinstall.service;
      systemctl enable --root=/target kickstart-berlin-postinstall.service'

  shutdown: reboot
